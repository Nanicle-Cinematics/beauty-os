// Beauty OS — multi-tenant core schema
//
// Tenancy model: single shared Postgres database, every tenant-scoped table
// carries a `businessId` column + index. Row-level isolation is enforced at
// the application layer (Prisma middleware / query scoping) and, in
// production, backed by Postgres Row Level Security policies keyed on
// `current_setting('app.current_business_id')`. See /prisma/RLS.md (added
// alongside the first migration) for the policy definitions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY & ACCESS
// ============================================================================

/// Platform-wide login identity. A single person can be staff at multiple
/// businesses, a customer of multiple businesses, and/or a platform admin —
/// this row is shared across all of those contexts.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  phone            String?
  passwordHash     String
  name             String
  avatarUrl        String?
  isPlatformAdmin  Boolean   @default(false)
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staffMemberships StaffMember[]
  customerProfiles Customer[]
  auditLogs        AuditLog[]
  sessions         Session[]
  emailVerificationTokens EmailVerificationToken[]
  mfaRecoveryCodes MfaRecoveryCode[]

  @@index([isPlatformAdmin])
}

/// Fixed-window rate-limit counter, keyed by e.g. "signup:<ip>". One row per
/// key, reset when its window expires. DB-backed so it works across serverless
/// instances (in-memory counters don't).
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt
}

/// One-time token to verify a user's email after self-serve signup. Raw token
/// lives only in the emailed link; we store its sha256 hash.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Server-side session record (supports session listing/revocation from
/// Settings → Security, and the "Session Management" requirement).
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

enum BusinessRole {
  OWNER
  MANAGER
  RECEPTIONIST
  SENIOR_ARTIST
  ARTIST
  CASHIER
  INVENTORY_OFFICER
}

enum StaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CommissionType {
  NONE
  PERCENTAGE
  FIXED
}

/// A staff member's membership in one business: role, schedule, commission,
/// and everything the "Staff Management" module needs. Not used for
/// customers — see `Customer` below.
model StaffMember {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  invitedEmail   String?
  role           BusinessRole
  status         StaffStatus    @default(INVITED)
  bio            String?
  colorHex       String?
  commissionType CommissionType @default(NONE)
  commissionValue Decimal?     @db.Decimal(6, 2)
  permissions    Json?
  joinedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workingHours     WorkingHours[]
  timeOff          TimeOff[]
  assignedServices ServiceStaff[]
  appointments     Appointment[]
  expenses         Expense[]
  auditLogs        AuditLog[]

  @@unique([businessId, userId])
  @@index([businessId])
}

model WorkingHours {
  id            String      @id @default(cuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  dayOfWeek     Int         // 0 = Sunday .. 6 = Saturday
  startTime     String?     // "09:00", null when isOff
  endTime       String?
  isOff         Boolean     @default(false)

  @@unique([staffMemberId, dayOfWeek])
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimeOff {
  id            String        @id @default(cuid())
  staffMemberId String
  staffMember   StaffMember   @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        TimeOffStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@index([staffMemberId])
}

// ============================================================================
// TENANT (BUSINESS)
// ============================================================================

/// Seeded lookup table (not an enum) so new business types can be added by
/// the platform admin without a schema migration.
model BusinessCategory {
  id        String   @id @default(cuid())
  key       String   @unique // "hair_salon", "barbershop", ...
  label     String
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  businesses Business[]
}

enum BusinessStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

model Business {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  categoryId   String
  category     BusinessCategory @relation(fields: [categoryId], references: [id])
  logoUrl      String?
  description  String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  country      String?
  timezone     String           @default("UTC")
  currency     String           @default("GHS")
  taxRate      Decimal?         @db.Decimal(5, 2)
  taxId        String?
  socialLinks  Json?
  status       BusinessStatus   @default(TRIAL)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  hours             BusinessHours[]
  staff             StaffMember[]
  serviceCategories ServiceCategory[]
  services          Service[]
  customers         Customer[]
  appointments      Appointment[]
  waitlistEntries   WaitlistEntry[]
  payments          Payment[]
  invoices          Invoice[]
  expenses          Expense[]
  suppliers         Supplier[]
  products          Product[]
  purchaseOrders    PurchaseOrder[]
  stockMovements    StockMovement[]
  coupons           Coupon[]
  loyaltyProgram    LoyaltyProgram?
  clientTiers       ClientTier[]
  campaigns         Campaign[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  notificationLogs  NotificationLog[]
  invites           BusinessInvite[]

  @@index([categoryId])
}

/// A pending invitation for someone to join a business (currently used to let
/// an onboarded owner set their own password instead of an admin-set one).
/// The raw token lives only in the invite link; we store its sha256 hash.
model BusinessInvite {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  name       String
  role       BusinessRole @default(OWNER)
  tokenHash  String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([businessId])
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  openTime   String?
  closeTime  String?
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
}

// ============================================================================
// SERVICES
// ============================================================================

model ServiceCategory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)

  services Service[]

  @@index([businessId])
}

model Service {
  id                 String            @id @default(cuid())
  businessId         String
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           ServiceCategory?  @relation(fields: [categoryId], references: [id])
  name               String
  description        String?
  price              Decimal           @db.Decimal(12, 2)
  depositAmount      Decimal?          @db.Decimal(12, 2)
  durationMinutes    Int
  colorHex           String?
  prepInstructions   String?
  cancellationPolicy String?
  availabilityRules  Json?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  images         ServiceImage[]
  assignedStaff  ServiceStaff[]
  productsUsed   ServiceProduct[]
  appointments   Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([businessId])
}

model ServiceImage {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model ServiceStaff {
  id            String      @id @default(cuid())
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([serviceId, staffMemberId])
}

/// Powers automatic stock deduction after a service is completed.
model ServiceProduct {
  id            String  @id @default(cuid())
  serviceId     String
  service       Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityUsed  Decimal @db.Decimal(10, 2)

  @@unique([serviceId, productId])
}

// ============================================================================
// CUSTOMER CRM
// ============================================================================

model Customer {
  id                    String   @id @default(cuid())
  businessId            String
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id])
  firstName             String
  lastName              String?
  phone                 String?
  email                 String?
  addressLine1          String?
  city                  String?
  birthdate             DateTime?
  anniversaryDate       DateTime?
  skinNotes             String?
  allergies             String?
  favoriteServiceId     String?
  favoriteStaffId       String?
  marketingOptInEmail    Boolean  @default(true)
  marketingOptInSms      Boolean  @default(true)
  marketingOptInWhatsapp Boolean  @default(true)
  tags                  String[]
  outstandingBalance    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  notes            CustomerNote[]
  photos           CustomerPhoto[]
  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  payments         Payment[]
  invoices         Invoice[]
  loyaltyLedger    LoyaltyLedgerEntry[]
  notificationLogs NotificationLog[]

  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, email])
}

model CustomerNote {
  id            String       @id @default(cuid())
  businessId    String
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorStaffId String?
  body          String
  createdAt     DateTime     @default(now())

  @@index([customerId])
}

model CustomerPhoto {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ============================================================================
// BOOKING & CALENDAR
// ============================================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  ONLINE
  WALK_IN
  PHONE
  ADMIN
}

model Appointment {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  serviceId     String
  service       Service           @relation(fields: [serviceId], references: [id])
  staffMemberId String?
  staffMember   StaffMember?      @relation(fields: [staffMemberId], references: [id])
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus @default(PENDING)
  source        BookingSource     @default(ONLINE)
  price         Decimal           @db.Decimal(12, 2)
  depositAmount Decimal?          @db.Decimal(12, 2)
  depositPaid   Boolean           @default(false)
  notes         String?
  cancelReason  String?
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payments       Payment[]
  invoices       Invoice[]
  stockMovements StockMovement[]

  @@index([businessId, startAt])
  @@index([staffMemberId, startAt])
  @@index([customerId])
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
}

model WaitlistEntry {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id])
  preferredStaffId String?
  earliestDate    DateTime?
  latestDate      DateTime?
  status          WaitlistStatus @default(WAITING)
  createdAt       DateTime       @default(now())

  @@index([businessId])
}

// ============================================================================
// PAYMENTS & FINANCE
// ============================================================================

enum PaymentMethod {
  PAYSTACK
  HUBTEL
  MOMO
  TELECEL_CASH
  BANK_TRANSFER
  CASH
}

enum PaymentType {
  DEPOSIT
  FULL_PAYMENT
  BALANCE
  REFUND
  PRODUCT_SALE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  appointmentId     String?
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id])
  invoiceId         String?
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  type              PaymentType
  status            PaymentStatus @default(PENDING)
  providerReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([businessId, createdAt])
  @@index([appointmentId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  appointmentId  String?
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([businessId, issuedAt])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
}

model Expense {
  id              String       @id @default(cuid())
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        String
  amount          Decimal      @db.Decimal(12, 2)
  description     String?
  incurredAt      DateTime
  createdByStaffId String?
  createdByStaff  StaffMember? @relation(fields: [createdByStaffId], references: [id])
  createdAt       DateTime     @default(now())

  @@index([businessId, incurredAt])
}

// ============================================================================
// INVENTORY
// ============================================================================

model Supplier {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  contactPhone  String?
  contactEmail  String?
  address       String?
  createdAt     DateTime @default(now())

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([businessId])
}

model Product {
  id               String    @id @default(cuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  name             String
  sku              String?
  barcode          String?
  category         String?
  costPrice        Decimal   @db.Decimal(12, 2)
  sellingPrice     Decimal?  @db.Decimal(12, 2)
  quantityOnHand   Decimal   @default(0) @db.Decimal(10, 2)
  reorderThreshold Decimal?  @db.Decimal(10, 2)
  expiryDate       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  usedInServices     ServiceProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@index([businessId])
  @@index([businessId, barcode])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  receivedAt DateTime?
  createdAt  DateTime            @default(now())

  items PurchaseOrderItem[]

  @@index([businessId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(10, 2)
  unitCost        Decimal       @db.Decimal(12, 2)
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  SERVICE_USAGE
  ADJUSTMENT
  EXPIRY_WRITE_OFF
}

model StockMovement {
  id                  String            @id @default(cuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  type                StockMovementType
  quantity            Decimal           @db.Decimal(10, 2)
  relatedAppointmentId String?
  relatedAppointment  Appointment?      @relation(fields: [relatedAppointmentId], references: [id])
  note                String?
  createdAt           DateTime          @default(now())

  @@index([businessId, createdAt])
  @@index([productId])
}

// ============================================================================
// MARKETING & LOYALTY
// ============================================================================

enum DiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code         String
  discountType DiscountType
  value        Decimal      @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int          @default(0)
  expiresAt    DateTime?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@unique([businessId, code])
}

model LoyaltyProgram {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pointsPerCurrencyUnit Decimal  @default(1) @db.Decimal(6, 2)
  redemptionRate        Decimal  @default(1) @db.Decimal(6, 2)
  active                Boolean  @default(true)
}

enum LoyaltyEntryType {
  EARNED
  REDEEMED
  ADJUSTED
}

model LoyaltyLedgerEntry {
  id                  String           @id @default(cuid())
  businessId          String
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points              Int
  type                LoyaltyEntryType
  relatedAppointmentId String?
  createdAt           DateTime         @default(now())

  @@index([customerId])
}

model ClientTier {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  minPoints       Int?
  minSpend        Decimal? @db.Decimal(12, 2)
  perks           String?
  discountPercent Decimal? @db.Decimal(5, 2)

  @@index([businessId])
}

enum CampaignChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CampaignType {
  BIRTHDAY
  HOLIDAY
  PROMO
  WINBACK
  REFERRAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

model Campaign {
  id             String          @id @default(cuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  channel        CampaignChannel
  type           CampaignType
  status         CampaignStatus  @default(DRAFT)
  scheduledAt    DateTime?
  content        String?
  audienceFilter Json?
  createdAt      DateTime        @default(now())

  @@index([businessId])
}

// ============================================================================
// PLATFORM BILLING (Beauty OS subscriptions, not the business's own finances)
// ============================================================================

enum PlanKey {
  STARTER
  PROFESSIONAL
  STUDIO
  ENTERPRISE
}

model Plan {
  id           String   @id @default(cuid())
  key          PlanKey  @unique
  name         String
  priceMonthly Decimal  @db.Decimal(12, 2)
  priceYearly  Decimal  @db.Decimal(12, 2)
  features     Json
  limits       Json
  isActive     Boolean  @default(true)

  subscriptions Subscription[]
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  billingCycle       BillingCycle
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  platformCouponId   String?
  platformCoupon     PlatformCoupon?    @relation(fields: [platformCouponId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model PlatformCoupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType
  value           Decimal      @db.Decimal(10, 2)
  maxRedemptions  Int?
  redeemedCount   Int          @default(0)
  expiresAt       DateTime?
  active          Boolean      @default(true)

  subscriptions Subscription[]
}

// ============================================================================
// PLATFORM ADMIN, SECURITY & NOTIFICATIONS
// ============================================================================

model AuditLog {
  id            String       @id @default(cuid())
  businessId    String?
  business      Business?    @relation(fields: [businessId], references: [id])
  actorUserId   String?
  actorUser     User?        @relation(fields: [actorUserId], references: [id])
  actorStaffId  String?
  actorStaff    StaffMember? @relation(fields: [actorStaffId], references: [id])
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([businessId, createdAt])
  @@index([actorUserId])
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationLog {
  id         String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?            @relation(fields: [customerId], references: [id])
  channel    NotificationChannel
  type       String
  recipient  String
  status     NotificationStatus   @default(PENDING)
  sentAt     DateTime?
  payload    Json?
  createdAt  DateTime             @default(now())

  @@index([businessId, createdAt])
}
