# Postgres connection string (Neon, Supabase, RDS, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/beauty_os?schema=public"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Payments
PAYSTACK_SECRET_KEY=""
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""

# AI assistant
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.1"

# Notifications
# Email transport precedence: SMTP (below) -> Resend -> dry-run.
# --- Option A: SMTP (works to any recipient without a verified domain) ---
# e.g. Gmail: host smtp.gmail.com, port 587, user = full address, pass = App Password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# --- Option B: Resend HTTP API (better deliverability; needs a verified domain) ---
RESEND_API_KEY=""
# Verified Resend sender, e.g. "Beauty OS <onboarding@yourdomain.com>"
EMAIL_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""   # your Twilio SMS-capable number, e.g. +14155552671
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""   # Meta WhatsApp Cloud API phone-number id

# Public base URL used to build links in emails (no trailing slash).
# Falls back to the request host when unset.
APP_URL=""

# --- Cloudflare R2 gallery storage ---
# R2 uses an S3-compatible API. Create an R2 bucket, create an API token with
# object read/write access for that bucket, then expose the bucket through a
# public.dev URL or a custom public domain.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL="" # e.g. https://pub-xxxx.r2.dev or https://media.example.com

# --- Error monitoring (Sentry) — optional; inert until DSN is set ---
# Server-side DSN (also used by edge). Get it from your Sentry project.
SENTRY_DSN=""
# Browser DSN (usually the same value as SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=""
# For readable stack traces in prod (source-map upload at build time):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Row-Level Security ---
# Owner DB URL (BYPASSRLS) for migrations / DDL. DATABASE_URL should be the
# restricted app_rls role. Set DB_RLS=on to enforce RLS at runtime.
MIGRATE_DATABASE_URL=""
DB_RLS="off"

# --- Two-factor auth (TOTP) ---
# 32-byte hex key that encrypts users' TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2FA is unavailable until this is set. Keep it stable — rotating it invalidates
# all enrolled authenticators.
MFA_SECRET_KEY=""

# --- Social login via WorkOS AuthKit (optional; inert until both keys are set) ---
# From dashboard.workos.com. Register redirect URI <APP_URL>/sso/callback and
# enable Google under Authentication > Providers. FREE AuthKit social login (not
# billed enterprise SSO). Unknown verified emails get a workspace created on the
# spot (JIT); known emails sign in (keeps your own sessions, MFA, and RLS).
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
# Show the "Continue with Microsoft" button only after Microsoft is configured
# under WorkOS Providers (otherwise it stays hidden so it can't 504 a customer).
WORKOS_MICROSOFT_ENABLED=""
